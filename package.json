{
  "name": "propermade-dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:content": "bun scripts/check-content.ts src public",
    "build": "bun run theme && bun run check:content && tsc --noEmit && vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server && bun scripts/prerender.ts && bun scripts/check-content.ts dist/client",
    "dev": "bun run theme && vite",
    "lint": "bun fmt && bun lint --type-aware",
    "preview": "vite preview --outDir dist/client",
    "theme": "bun scripts/build-theme.ts",
    "typecheck": "tsrs --noEmit --fast",
    "prepare": "husky"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.17",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@propermade/core": "^0.5.0",
    "@stylexjs/stylex": "^0.19.2",
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.15",
    "@stylexjs/unplugin": "^0.19.2",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "husky": "^9.1.7",
    "tsrs": "^7.1.0-beta.tsrs5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}

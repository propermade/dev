{
  "name": "propermade-dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run check:content && tsc --noEmit && vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server && bun scripts/prerender.ts && bun scripts/check-content.ts dist/client",
    "preview": "vite preview --outDir dist/client",
    "typecheck": "tsc --noEmit",
    "check:content": "bun scripts/check-content.ts src public"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.17",
    "@propermade/core": "link:../ui/packages/core",
    "@stylexjs/stylex": "^0.19.2",
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "^0.19.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
